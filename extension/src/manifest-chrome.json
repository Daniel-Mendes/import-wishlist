{
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_extensionName__"
  },
  "author": "Daniel Mendes",
  "background": {
    "service_worker": "background/background-new.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://auth.gog.com/token*",
        "https://embed.gog.com/on_login_success*"
      ],
      "js": ["content/content-injector.js"],
      "run_at": "document_end"
    }
  ],
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "host_permissions": [
    "https://store.steampowered.com/wishlist/profiles/*",
    "https://steamcommunity.com/*",
    "https://*.gog.com/*",
    "https://import-wishlist.netlify.app/.netlify/functions/*"
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "permissions": ["storage", "identity", "webNavigation", "scripting", "tabs"],
  "version": "0.1.1",
  "web_accessible_resources": [
    {
      "resources": [
        "content/content-new.js",
        "shared/constants.js",
        "shared/utils.js"
      ],
      "matches": ["https://*.gog.com/*"]
    }
  ]
}
